# Copie para .env e ajuste conforme o necessário.
# DJANGO_SECRET_KEY é OBRIGATÓRIO em produção — o projeto não inicia sem ela.
# Gere com:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=coloque-uma-chave-secreta-longa-e-aleatoria
# OBRIGATÓRIO em produção (site para de iniciar sem ele).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,animabrasil.com.br

DB_NAME=animacoes_brasileiras
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Produção: SSL e cookies seguros (mantenha True)
# Estas opções só valem quando DJANGO_DEBUG=False. Em teste LOCAL de produção
# defina DJANGO_HSTS_SECONDS=0 (e DJANGO_SECURE_SSL_REDIRECT=False) para não
# gravar HSTS no navegador contra 127.0.0.1.
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_HSTS_SECONDS=31536000

# Origens confiáveis para CSRF com HTTPS em domínio próprio (produção).
# Ex.: DJANGO_CSRF_TRUSTED_ORIGINS=https://animabrasil.com.br,https://www.animabrasil.com.br
DJANGO_CSRF_TRUSTED_ORIGINS=

# Cache: padrão LocMem (por processo). Em produção com múltiplos workers,
# use um cache compartilhado (Redis/Memcached) para o rate limit de login.
# NÃO defina CACHE_BACKEND/CACHE_LOCATION vazios — valores vazios quebram a
# inicialização do Django (o servidor não sobe). Em desenvolvimento o cache
# LocMem é usado por padrão.
# CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
# CACHE_LOCATION=redis://127.0.0.1:6379/1

# E-mail (backends de produção)
EMAIL_HOST=smtp.exemplo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@animabrasil.com.br